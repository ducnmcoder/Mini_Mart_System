<mxCell id="configNote-body" value="passwordEncoder() → new BCryptPasswordEncoder()&#xa;permitAll: /forgot-password, /forgot-password/reset" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontStyle=0;fontColor=#172033;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="configNote"><mxGeometry x="12" y="46" width="626" height="54" as="geometry"/></mxCell>
<mxCell id="frameworkNote" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="60" y="1150" width="650" height="244" as="geometry"/></mxCell>
<mxCell id="frameworkNote-title" value="«Framework — được Controller.reset(...) sử dụng»" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#0F172A;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="frameworkNote"><mxGeometry x="12" y="12" width="626" height="27" as="geometry"/></mxCell>
<mxCell id="frameworkNote-body" value="HttpSession: getAttribute(), setAttribute(), removeAttribute()&#xa;HttpServletRequest: getSession(), changeSessionId()&#xa;UsernamePasswordAuthenticationToken.authenticated(...)&#xa;SecurityContextHolder.createEmptyContext(), setContext(...)&#xa;SecurityContext.setAuthentication(...)&#xa;HttpSessionSecurityContextRepository.saveContext(...)&#xa;UserDetails: getUsername(), getAuthorities()&#xa;ObjectMapper.writeValueAsString(...) được AuditServiceImpl gọi" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontStyle=0;fontColor=#172033;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="frameworkNote"><mxGeometry x="12" y="46" width="626" height="192" as="geometry"/></mxCell>
<mxCell id="legend" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="60" y="1510" width="650" height="221" as="geometry"/></mxCell>
<mxCell id="legend-title" value="Quy ước và phạm vi" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#0F172A;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="legend"><mxGeometry x="12" y="12" width="626" height="27" as="geometry"/></mxCell>
<mxCell id="legend-body" value="+ public  ·  - private  ·  ~ package visibility&#xa;Nét liền + đầu mở: association / dependency được inject.&#xa;Nét đứt + tam giác rỗng: implements interface.&#xa;Nét đứt + đầu mở: sử dụng kiểu dữ liệu / tạo đối tượng.&#xa;0..* → 1: nhiều UserAccount thuộc đúng một Role.&#xa;Chỉ hiển thị thành viên phục vụ chức năng quên mật khẩu.&#xa;Tên lớp trùng tên file .java; UI là template, không là lớp Java." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontStyle=0;fontColor=#172033;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="legend"><mxGeometry x="12" y="46" width="626" height="169" as="geometry"/></mxCell>
<mxCell id="text-0" value="QUÊN MẬT KHẨU — CLASS DIAGRAM" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=29;fontStyle=1;fontColor=#0F172A;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="60" y="22" width="3120" height="45" as="geometry"/></mxCell>
<mxCell id="text-1" value="Phạm vi thành viên: tìm số điện thoại → đặt mật khẩu mới → ghi nhật ký → tự động đăng nhập và chọn dashboard." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#334155;fillColor=none;strokeColor=none;spacing=0;" vertex="1" connectable="0" parent="1"><mxGeometry x="60" y="75" width="3120" height="30" as="geometry"/></mxCell>
